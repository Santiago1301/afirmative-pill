# Connection string del "Shared pooler" (Session, puerto 5432) de Supabase
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
PORT=4000
# Retrasos artificiales para hacer visible la consistencia eventual en la demo (ms)
PROJECTION_DELAY_MS=1500
APPROVAL_DELAY_MS=5000
